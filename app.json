{
  "expo": {
    "name": "ApniDiaries",
    "slug": "native-app",
    "version": "2.0.1",
    "orientation": "default",
    "icon": "./assets/AD.png",
    "scheme": "apnidiaries",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apnidiaries.app",
      "associatedDomains": [
        "applinks:apnidiaries.com",
        "applinks:www.apnidiaries.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use your location to find nearby community posts.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take photos for your posts.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to share photos.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for recording videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/AD-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.apnidiaries.app",
      "versionCode": 2,
      "abiFilters": ["arm64-v8a"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "apnidiaries.com", "pathPrefix": "/chat" },
            { "scheme": "https", "host": "apnidiaries.com", "pathPrefix": "/profile" },
            { "scheme": "https", "host": "apnidiaries.com", "pathPrefix": "/post" },
            { "scheme": "https", "host": "apnidiaries.com", "pathPrefix": "/friend-requests" },
            { "scheme": "https", "host": "www.apnidiaries.com", "pathPrefix": "/chat" },
            { "scheme": "https", "host": "www.apnidiaries.com", "pathPrefix": "/profile" },
            { "scheme": "https", "host": "www.apnidiaries.com", "pathPrefix": "/post" },
            { "scheme": "https", "host": "www.apnidiaries.com", "pathPrefix": "/friend-requests" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/AD.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withOptionalAndroidFeatures",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ApniDiaries to scan pairing QR codes and take photos for your posts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F97316",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/AD-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
  "expo-build-properties",
  {
    "android": {
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "ios": {
      "enableSceneSupport": true
    }
  }
]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3b2794d-2b55-4e32-b271-93a9691634f2"
      }
    },
    "owner": "nav33njangir"
  }
}
